    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5",
    "postcss": "^8.5.29",
    "tailwindcss": "3.4",
    "tsx": "^4.23.15",
    "typescript": "5.8",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
