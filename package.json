{
  "name": "sunway-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial, non-commercial, members-only study resources and campus events site for the Sunway University community.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
