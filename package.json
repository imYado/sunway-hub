    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "@node-rs/argon2": "^2.2.2",
    "@vercel/blob": "^2.8.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.55.0",
    "next": "15.5",
    "nodemailer": "^7.0.13",
    "obscenity": "^0.4.6",
    "otplib": "^12.0.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.1",
    "react-dom": "19.1",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
