# ---------------------------------------------------------------------------
# SJ Study environment variables. Copy to .env.local for development and
# set the same keys in Vercel > Project > Settings > Environment Variables.
# ---------------------------------------------------------------------------

# Neon Postgres (Singapore region). Use the POOLED connection string for the app
# (host contains "-pooler"). Migrations may use the direct (unpooled) string.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/sunwayhub?sslmode=require
DATABASE_URL_UNPOOLED=

# Vercel Blob (PRIVATE store). Not needed on Vercel when the store is connected
# to the project and OIDC auth is available (BLOB_STORE_ID is set automatically).
BLOB_READ_WRITE_TOKEN=

# Long random strings (at least 32 characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
OTP_PEPPER=

# The one and only admin account. Enforced on the server.
ADMIN_EMAIL=mohammedalqadhi745@gmail.com

# Comma-separated list of exact email domains that may sign in.
ALLOWED_EMAIL_DOMAINS=imail.sunway.edu.my,sunway.edu.my

# Gmail SMTP (dedicated account with 2-step verification + app password).
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM="SJ Study <your-dedicated-account@gmail.com>"

# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Public base URL of the site, no trailing slash.
APP_URL=http://localhost:3000

# Global storage guard for the shared Blob allowance (GB). Warn at 80%, refuse uploads at 90%.
STORAGE_CAP_GB=1

# --- Development / test only (never set these in production) ---------------
# STORAGE_DRIVER=local     # store files under .data/blob instead of Vercel Blob
# EMAIL_TRANSPORT=file     # write emails to .data/outbox instead of sending them
